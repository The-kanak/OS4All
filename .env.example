# Environment Variables Configuration Template
# OS4All - Personalized Health Baseline & Multi-Signal Intelligence Engine
#
# NOTE: DO NOT commit real API keys or credentials to version control.
# Copy this file to .env or export these variables into your local environment.

# ==========================================
# SERVER CONFIGURATION
# ==========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# DATABASE CONFIGURATION (MySQL)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=os4all
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/os4all?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ==========================================
# SECURITY & JWT CONFIGURATION
# ==========================================
# Minimum 256-bit base64-encoded secret key
APP_SECURITY_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_SECURITY_JWT_EXPIRATION_MS=86400000

# ==========================================
# AI LAYER: NEBIUS AI STUDIO & NVIDIA NEMOTRON
# ==========================================
# Active provider: 'mock' (offline deterministic) or 'nebius' (remote inference)
OS4ALL_AI_PROVIDER=mock
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/Llama-3_1-Nemotron-70B-Instruct
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1500
AI_TIMEOUT_MS=30000

# ==========================================
# EVIDENCE RETRIEVAL: TAVILY SEARCH API
# ==========================================
# Active provider: 'mock' (offline deterministic) or 'tavily' (live search)
APP_EVIDENCE_PROVIDER=mock
APP_EVIDENCE_ENABLED=true
APP_EVIDENCE_API_KEY=your_tavily_api_key_here
APP_EVIDENCE_MAX_RESULTS=3
APP_EVIDENCE_SEARCH_DEPTH=advanced
APP_EVIDENCE_INCLUDE_DOMAINS=pubmed.ncbi.nlm.nih.gov,nature.com,nejm.org,frontiersin.org,ahajournals.org

# ==========================================
# OCR & REPORT STORAGE CONFIGURATION
# ==========================================
APP_STORAGE_UPLOAD_DIR=./uploads/reports
APP_STORAGE_MAX_FILE_SIZE_MB=15

# ==========================================
# FRONTEND CONFIGURATION (Flutter)
# ==========================================
# Mobile device / emulator points to backend host:
# Android Emulator: http://10.0.2.2:8080/api/v1
# iOS Simulator / Web: http://localhost:8080/api/v1
OS4ALL_API_BASE_URL=http://localhost:8080/api/v1
